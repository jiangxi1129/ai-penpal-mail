# 邮箱账号（AI 自己的 Gmail）
MAIL_USER=mira.ai@gmail.com
MAIL_FROM_NAME=Mira
MAIL_FROM="Mira <mira.ai@gmail.com>"

# Gmail OAuth2（Google Cloud Console 建 OAuth 客户端，拿 refresh token，见 README）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# HTTP 模式端口（只监听 127.0.0.1）
PORT=3457
# 可选：出门要走代理时填
PROXY=
# 可选：只读存档接口的令牌（给自己的前端看信用；不填就不开）
MAIL_READ_TOKEN=
# 可选：数据文件位置
MAIL_CONTACTS_FILE=./data/mail-contacts.json
MAIL_ARCHIVE_FILE=./data/mail-archive.json
MAIL_ARCHIVE_SINCE=2026/01/01
