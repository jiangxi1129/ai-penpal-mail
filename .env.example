# 邮箱类型：gmail（默认）或 163 / 126 / yeah / qq / foxmail / yahoo / icloud / imap
#   gmail 走 Gmail API（要填下面 GMAIL_* 三项）；其余走 IMAP+SMTP，只要填 MAIL_PASSWORD（授权码）
MAIL_PROVIDER=gmail

# 邮箱账号（AI 自己的 Gmail）
MAIL_USER=mira.ai@gmail.com
MAIL_FROM_NAME=Mira
MAIL_FROM="Mira <mira.ai@gmail.com>"

# 非 Gmail：邮箱设置里开启 IMAP/SMTP 服务后生成的「授权码」（不是登录密码）
MAIL_PASSWORD=
# 不在预设里的邮箱（MAIL_PROVIDER=imap）自己填服务器；预设邮箱不用填
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=465

# Gmail OAuth2（只有 MAIL_PROVIDER=gmail 要填；Google Cloud Console 建 OAuth 客户端，见 README）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# HTTP 模式端口（只监听 127.0.0.1）
PORT=3457
# 可选：出门要走代理时填
PROXY=
# 可选：只读存档接口的令牌（给自己的前端看信用；不填就不开）
MAIL_READ_TOKEN=
# 可选：数据文件位置
MAIL_CONTACTS_FILE=./data/mail-contacts.json
MAIL_ARCHIVE_FILE=./data/mail-archive.json
MAIL_ARCHIVE_SINCE=2026/01/01
